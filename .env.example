NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Use the Supabase secret key or the legacy service_role key.
SUPABASE_SECRET_KEY=
# Server only. Generate once with openssl rand -hex 32.
RIDE_LINK_SECRET=
# Optional canonical origin for copied links. Set this to the production URL when enabling Google.
NEXT_PUBLIC_APP_URL=
# Optional. Enable Google in Supabase before setting this to true.
CARPOOL_GOOGLE_LOGIN=false
# Optional alternative OSM-compatible raster tile URL and plain-text credit.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_CREDIT=
